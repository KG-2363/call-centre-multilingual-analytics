# ---------------------------------------------------------------------------
# Copy to .env and edit.  Never commit .env.
# ---------------------------------------------------------------------------

# Where all lake artefacts live (bronze/, silver/, gold/, warehouse.duckdb)
CCMA_DATA_ROOT=./data

# ---- ASR ------------------------------------------------------------------
# mock  = deterministic offline transcripts derived from the template bank
# faster_whisper = real ASR (needs `pip install -r requirements-heavy.txt` + ffmpeg)
CCMA_ASR_BACKEND=mock
CCMA_WHISPER_MODEL=large-v3
CCMA_WHISPER_DEVICE=auto
CCMA_WHISPER_COMPUTE_TYPE=int8
# Second, cheaper model used only for dual-decode agreement (ASR quality proxy).
CCMA_WHISPER_SHADOW_MODEL=small

# ---- LLM enrichment (Ollama) ----------------------------------------------
# mock   = deterministic rule-derived enrichment, no server required
# ollama = local Ollama server
CCMA_LLM_BACKEND=mock
CCMA_OLLAMA_HOST=http://localhost:11434
# Bulk tier — every call goes through this one.
CCMA_OLLAMA_MODEL=qwen2.5:7b-instruct
# Escalation tier — only low-confidence / disputed calls are re-run here.
CCMA_OLLAMA_MODEL_HEAVY=qwen2.5:14b-instruct
# LLM-as-judge (kept distinct from the generator to avoid self-preference bias).
CCMA_OLLAMA_MODEL_JUDGE=gemma2:9b
# Multilingual embeddings for compliance similarity + intent clustering.
CCMA_OLLAMA_EMBED_MODEL=bge-m3
CCMA_OLLAMA_TIMEOUT_S=180
CCMA_OLLAMA_NUM_CTX=8192
CCMA_LLM_MAX_RETRIES=3
CCMA_LLM_CONCURRENCY=4

# ---- TTS (synthetic corpus) -----------------------------------------------
# none      = write transcripts only, no audio files
# edge_tts  = real neural TTS via edge-tts (network required, free)
CCMA_TTS_BACKEND=none

# ---- Corpus ---------------------------------------------------------------
CCMA_CORPUS_SIZE=30
CCMA_RANDOM_SEED=20260731

# ---- Ops ------------------------------------------------------------------
CCMA_LOG_LEVEL=INFO
CCMA_LOG_JSON=false
